# Eden Agent Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# REQUIRED: API Keys
# ============================================================================

# Anthropic API Key (Required)
# Get your API key from: https://console.anthropic.com/
# This is required for the agent to function
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================================
# Model Configuration
# ============================================================================

# Model to use (default: claude-sonnet-4-5)
# Available models: claude-sonnet-4, claude-sonnet-4-5, claude-opus-4
MODEL_NAME=claude-sonnet-4-5

# Maximum tokens to generate (default: 4096)
# Range: 1 to 200000
MAX_TOKENS=4096

# Temperature for generation (default: 0.7)
# Range: 0.0 (deterministic) to 2.0 (very creative)
TEMPERATURE=0.7

# ============================================================================
# Tracing Configuration
# ============================================================================

# Enable distributed tracing (default: true)
# Set to false to disable OpenTelemetry tracing
ENABLE_TRACING=true

# Trace exporter type (default: console)
# Options: console, jaeger, zipkin, otlp
TRACE_EXPORTER=console

# ============================================================================
# Logging Configuration
# ============================================================================

# Logging level (default: INFO)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Use rich console logging (default: true)
# Set to false for plain text logs
ENABLE_RICH_LOGGING=true

# ============================================================================
# Rate Limiting Configuration
# ============================================================================

# Enable API rate limiting (default: true)
# Set to false to disable rate limiting (not recommended for production)
RATE_LIMIT_ENABLED=true

# Maximum API calls per time window (default: 50)
# Adjust based on your API tier and usage patterns
RATE_LIMIT_MAX_CALLS=50

# Rate limit time window in seconds (default: 60.0)
# This defines the rolling window for rate limiting
RATE_LIMIT_TIME_WINDOW=60.0

# ============================================================================
# Retry Configuration
# ============================================================================

# Enable retry logic for API failures (default: true)
# Automatically retries failed requests with exponential backoff
RETRY_ENABLED=true

# Maximum retry attempts (default: 3)
# Range: 1 to 10
RETRY_MAX_ATTEMPTS=3

# Base delay for retries in seconds (default: 1.0)
# Starting delay before first retry
RETRY_BASE_DELAY=1.0

# Maximum retry delay in seconds (default: 60.0)
# Maximum time to wait between retries
RETRY_MAX_DELAY=60.0

# ============================================================================
# ============================================================================




# ============================================================================
# Beta Testing Notes
# ============================================================================

# For beta testers:
# 1. Always use a valid ANTHROPIC_API_KEY
# 2. Start with default values for MODEL_NAME, MAX_TOKENS, and TEMPERATURE
# 3. Enable tracing to help debug issues
# 4. Set LOG_LEVEL=DEBUG for detailed troubleshooting
# 5. Report any issues with your configuration to the development team
