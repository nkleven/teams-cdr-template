# Azure AD B2C Configuration
VITE_AZURE_CLIENT_ID=your-client-id-here
VITE_AZURE_AUTHORITY=https://yourtenantname.b2clogin.com/yourtenantname.onmicrosoft.com/B2C_1_signupsignin
VITE_AZURE_KNOWN_AUTHORITY=yourtenantname.b2clogin.com
VITE_AZURE_REDIRECT_URI=http://localhost:5173
VITE_AZURE_POST_LOGOUT_URI=http://localhost:5173
VITE_AZURE_API_SCOPE=https://yourtenantname.onmicrosoft.com/cdr-api/CDR.ReadWrite

# Azure Functions API
VITE_API_BASE_URL=https://your-function-app.azurewebsites.net/api

# Power BI Configuration
VITE_POWERBI_WORKSPACE_ID=your-workspace-id
VITE_POWERBI_REPORT_ID=your-report-id
VITE_POWERBI_EMBED_URL=https://app.powerbi.com/reportEmbed

# Azure Key Vault
VITE_KEYVAULT_URL=https://your-keyvault.vault.azure.net/

# Backend Only (Do not expose in frontend)
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=cdr-database
AZURE_SQL_USER=your-admin-user
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_SECRET=your-client-secret
